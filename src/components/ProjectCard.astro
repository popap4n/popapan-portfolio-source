---
import type { CollectionEntry } from 'astro:content';
import { isRealMediaPath } from '../data/site';
import MediaPlaceholder from './MediaPlaceholder.astro';
interface Props { project: CollectionEntry<'projects'>; showDates?: boolean; }
const { project, showDates = false } = Astro.props;
const data = project.data;
---
<article class="project-card">
  <div class="project-card__media">
    {isRealMediaPath(data.image) ? <img src={data.image} alt={data.imageAlt} loading="lazy" width="960" height="600" /> : <MediaPlaceholder label={data.image} />}
  </div>
  <div class="project-card__body">
    <p class="eyebrow">{data.context}</p>
    <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
    <p class="project-card__summary">{data.summary}</p>
    <dl class="project-facts">
      <div><dt>Engine</dt><dd class:list={{ placeholder: data.engine.startsWith('[REPLACE:') }}>{data.engine}</dd></div>
      <div><dt>Language</dt><dd>{data.languages.join(', ')}</dd></div>
      <div><dt>Type</dt><dd class:list={{ placeholder: data.projectType === 'unspecified' }}>{data.projectType === 'unspecified' ? '[REPLACE: Individual or team project]' : data.projectType === 'team' ? 'Team project' : 'Individual project'}</dd></div>
      {showDates && <div><dt>Dates</dt><dd class:list={{ placeholder: data.startDate.startsWith('[REPLACE:') || data.endDate.startsWith('[REPLACE:') }}>{data.startDate} – {data.endDate}</dd></div>}
    </dl>
    <a class="text-link" href={`/projects/${project.id}/`}>Read {data.title} case study <span aria-hidden="true">→</span></a>
  </div>
</article>
